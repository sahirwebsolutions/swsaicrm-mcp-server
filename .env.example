# FastAPI CRM base (no trailing slash)
CRM_API_BASE_URL=http://localhost:8000

# Must match CRM JWT signing secret (FastAPI JWT_SECRET_KEY or this alias)
JWT_SECRET=replace_me

# HS256 by default — must match FastAPI JWT_ALGORITHM if overridden
JWT_ALGORITHM=HS256

# stdio (Cursor) or http
MCP_TRANSPORT=stdio
MCP_PORT=3100
MCP_HOST=0.0.0.0

# For stdio MCP: paste CRM access JWT (same as browser session token after login), or use Authorization in HTTP mode
MCP_BEARER_TOKEN=

TOOL_MAX_RESULTS=50
CACHE_TTL_SECONDS=10

# Integer limit + optional /minute|/hour|/second suffix
RATE_LIMIT_PER_USER=60/min
RATE_LIMIT_PER_WORKSPACE=300/min
RATE_LIMIT_GLOBAL=1000/min

HTTPX_TIMEOUT_SECONDS=10
HTTPX_MAX_RETRIES=2
TOOL_TIMEOUT_SECONDS=12

# Safety
MAX_JSON_PAYLOAD_BYTES=65536
MAX_SEARCH_STRING_LEN=512

# Log one JSON line per tool call (event=mcp_tool_audit, params fingerprint only — no raw args)
MCP_AUDIT_TOOL_CALLS=true
# Reject tool args that include workspace/user identity overrides (JWT is source of truth)
MCP_REJECT_IDENTITY_ARGS=true

# Optional: refuse writes (still validates auth)
DRY_RUN=false

# Rate limits: per-minute Redis buckets (optional — falls back to in-memory if unset/unreachable)
REDIS_URL=

# Circuit breaker for upstream FastAPI calls
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_WINDOW_SECONDS=30
CIRCUIT_COOLDOWN_SECONDS=30
